	"item": [
		{
			"name": "create-user",
			"item": [
				{
					"name": "creating user",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const moment = require('moment');",
									"const datetime = moment().format(\"YYMMDD.HHmm\")",
									"const email = datetime + \"@fletcherjd.com\";",
									"pm.environment.set(\"var_userEmail\", email);"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json()",
									"",
									"pm.environment.set('var_userEmail', response.email)",
									"pm.environment.set('var_account_id', response.accountId)",
									"pm.environment.set('var_consumer_id', response.consumerId)",
									"pm.environment.set('var_customer_id', response.customerId)",
									"",
									"pm.test(\"Success\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"env\": \"{{long_env}}\",\n    \"product\": \"{{product}}\",\n    \"token\": \"AutomationTest\",\n    \"email\": \"{{var_userEmail}}\",\n    \"isLongPolling\": false\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{url_user}}/createuser",
							"host": [
								"{{url_user}}"
							],
							"path": [
								"createuser"
							]
						}
					},
					"response": []
				},
				{
					"name": "updating profile",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Success\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"console.log('here you go :)')",
									"console.log()",
									"console.log('user details:')",
									"console.log(`email: ${pm.environment.get('var_userEmail')}`)",
									"console.log(`customerId: ${pm.environment.get('var_customer_id')}`)",
									"console.log(`accountId: ${pm.environment.get('var_account_id')}`)",
									"console.log(`consumerId: ${pm.environment.get('var_consumer_id')}`)",
									"console.log(`http://admin-cs.${pm.environment.get('env')}.au.edge.zip.co/customers/${pm.environment.get('var_consumer_id')}`)"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"Fletcher\",\n    \"lastName\": \"Dick\",\n    \"gender\": \"Male\",\n    \"dateOfBirth\": \"2000-03-10\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{url_cust}}/api/v1/Customer/{{var_customer_id}}/personal-details",
							"host": [
								"{{url_cust}}"
							],
							"path": [
								"api",
								"v1",
								"Customer",
								"{{var_customer_id}}",
								"personal-details"
							]
						}
					},
					"response": []
				}
			],
			"description": "create a test user"
		},
